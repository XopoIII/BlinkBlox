---
// The plugin's toolbar in Studio's Plugins tab: one group, "BlinkBlox Suite", with one button,
// "Editor" (plugin/src/init.server.luau). The button stays highlighted while the editor is open.
import Icon from './Icon.astro';

interface Props {
	label: string;
	caption?: string;
	active?: boolean;
}

const { label, caption, active = false } = Astro.props;
---

<figure class="bbp-figure not-content">
	<div class="bbp-toolbar" role="img" aria-label={label}>
		<div class="bbp-toolbar-tabs">
			<span>Home</span><span>Model</span><span>Test</span><span>View</span><span class="bbp-toolbar-tab-active">Plugins</span>
		</div>
		<div class="bbp-toolbar-ribbon">
			<div class="bbp-toolbar-group">
				<div class:list={['bbp-toolbar-button', { 'bbp-toolbar-button-active': active }]}>
					<Icon name="editor" size={30} />
					<span>Editor</span>
				</div>
				<div class="bbp-toolbar-group-name">BlinkBlox Suite</div>
			</div>
		</div>
	</div>
	{caption && <figcaption class="bbp-caption">{caption}</figcaption>}
</figure>

<style is:global>
	.bbp-toolbar {
		width: 360px;
		max-width: 100%;
		box-sizing: border-box;
		border: 1px solid #1a1a1a;
		background: #2e2e2e;
		color: #d4d4d4;
		font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
		font-size: 12px;
		line-height: normal;
		box-shadow: 0 0.75rem 2rem -1rem rgb(0 0 0 / 0.6);
		overflow: hidden;
	}

	.bbp-toolbar-tabs {
		display: flex;
		gap: 16px;
		height: 26px;
		align-items: center;
		padding: 0 10px;
		background: #353535;
		border-bottom: 1px solid #1e1e1e;
		color: #9a9a9a;
		white-space: nowrap;
	}

	.bbp-toolbar-tab-active {
		color: #ffffff;
		box-shadow: inset 0 -2px 0 #3a96dd;
		line-height: 24px;
	}

	.bbp-toolbar-ribbon {
		display: flex;
		justify-content: flex-end;
		padding: 6px 6px 0;
	}

	.bbp-toolbar-group {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 6px;
		border-left: 1px solid #444;
	}

	.bbp-toolbar-button {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		padding: 6px 12px;
		border-radius: 3px;
		color: #e8e8e8;
	}

	.bbp-toolbar-button-active {
		background: #4a4a4a;
	}

	.bbp-toolbar-group-name {
		padding: 4px 0 5px;
		color: #9a9a9a;
		white-space: nowrap;
	}
</style>
