---
// A Studio dock widget: the title bar Studio draws around a plugin's window, and the plugin's own
// interface inside it. `label` is what a screen reader hears in place of the whole picture.
import Icon from './Icon.astro';

interface Props {
	title: string;
	label: string;
	/** Width in pixels. The editor opens at 360 wide; the error window at 500. */
	width?: number;
	/** A floating window has a close button only; a docked one can also be undocked. */
	floating?: boolean;
	caption?: string;
}

const { title, label, width = 360, floating = false, caption } = Astro.props;
---

<figure class="bbp-figure not-content">
	<div class="bbp-window" role="img" aria-label={label} style={`width:${width}px`}>
		<div class="bbp-titlebar">
			<span class="bbp-titlebar-text">{title}</span>
			<span class="bbp-titlebar-buttons">
				{!floating && <Icon name="undock" size={14} />}
				<Icon name="close" size={14} />
			</span>
		</div>
		<div class="bbp-window-body">
			<slot />
		</div>
	</div>
	{caption && <figcaption class="bbp-caption">{caption}</figcaption>}
</figure>

<style is:global>
	.bbp-figure {
		margin: 1.5rem 0;
		max-width: 100%;
	}

	.bbp-window {
		max-width: 100%;
		box-sizing: border-box;
		border: 1px solid #1a1a1a;
		background: #282828;
		color: #ffffff;
		box-shadow: 0 0.75rem 2rem -1rem rgb(0 0 0 / 0.6);
		overflow: hidden;
		font-family: 'Fira Sans', 'Segoe UI', system-ui, -apple-system, sans-serif;
		line-height: normal;
		text-align: left;
	}

	.bbp-titlebar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 24px;
		padding: 0 52px;
		background: #353535;
		border-bottom: 1px solid #1e1e1e;
		color: #b8b8b8;
		font-size: 13px;
		font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
		white-space: nowrap;
	}

	.bbp-titlebar-text {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.bbp-titlebar-buttons {
		position: absolute;
		right: 6px;
		top: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		gap: 6px;
		color: #d0d0d0;
	}

	.bbp-window-body {
		position: relative;
	}

	.bbp-caption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
