--!strict
--- Three plain `f32` fields of a struct, read and written as one vector where the VM can.
---
--- Luau 0.747 adds `buffer.readvectorf32x3` and `buffer.writevectorf32x3`, which move three floats in
--- one instruction, and the Roblox client keeps them behind a fast flag a running game may or may
--- not have. The option that decides -- `VectorPacking`, `Auto` by default -- is read by the caller,
--- and this file emits what it asks for.
---
--- Split out of Serde.luau when that file reached its size cap.

local Blocks = require("./Blocks")
local Parser = require("../Parser")
local Prefabs = require("./Prefabs")
local State = require("./State")

type Type = Parser.TypeNode

---> Names of the runtime buffers, as Blocks.luau and Common.luau spell them.
local SEND_BUFFER = "SendBuffer"
local RECIEVE_BUFFER = "RecieveBuffer"

---> The width of a packed run: the VM's vector holds three components, so the buffer calls that move
---> one move three floats.
local FIELDS = 3

local Packing = {}

--- How many fields a packed run takes. The caller advances its own cursor by this many.
Packing.FIELDS = FIELDS

--- Whether `Field` is a plain `f32`: the primitive, with no range, class, scale or saturation, so its
--- bytes are four of nothing but the number.
function Packing.IsPlainF32(Field: Type): boolean
	if Field.Type ~= "Primitive" or Field.Tokens.Primitive.Value ~= "f32" then
		return false
	end

	local Value = Field.Value
	return Value.Range == nil and Value.Class == nil and Value.Scale == nil and Value.Saturate ~= true
end

--- An offset `By` bytes past `Offset`, folded into the expression where a block writes its offsets as
--- `BLOCK_START + N`, so a packed run reads `BLOCK_START + 13` and not `BLOCK_START + 9 + 4`.
local function Plus(Offset: string, By: number): string
	local Base, Number = string.match(Offset, "^(.-)%s%+%s(%d+)$")
	if Base then
		return `{Base} + {tonumber(Number) :: number + By}`
	end
	return `({Offset}) + {By}`
end

--- Reads and writes `Names`, three plain `f32` fields of a struct, as one vector where the VM can.
---
--- `Auto` asks the VM at the packet and writes the run either way: both paths put the same three
--- floats at the same offset, so a client and a server generated by the same release read each
--- other's packets whichever way the flag falls. `On` takes the call without asking; `Off` never
--- packs.
---
--- The twelve bytes are claimed once, by the caller, and never inside a branch: an allocation in a
--- branch would leave the block's own size short of the bytes it wrote, and every offset a later
--- field, an enclosing array or the size analysis works out from it would then be wrong.
function Packing.Emit(Names: { string }, Read: Blocks.Block, Write: Blocks.Block, Mode: string)
	local Vector = `Vector3.new({Names[1]}, {Names[2]}, {Names[3]})`

	--> A packed field is written by the vector call, so the primitive's own check never runs for it.
	--> Say what it would have said, before the write and not inside a branch, so both paths refuse a
	--> wrong type alike.
	if State.Options.WriteValidations == true then
		for _, Name in Names do
			Prefabs.TypeCheck(Write, Name, "number")
		end
	end

	local WriteOffset = Write:Allocate(12)
	if Mode == "On" then
		Write:Line(`buffer.writevectorf32x3({SEND_BUFFER}, {WriteOffset}, {Vector})`)
	else
		local Packed = Write:Compare("buffer.writevectorf32x3", "nil", "Not")
		Packed:Line(`buffer.writevectorf32x3({SEND_BUFFER}, {WriteOffset}, {Vector})`)
		local Unpacked = Packed:Branch("Default")
		Unpacked:Line(`buffer.writef32({SEND_BUFFER}, {WriteOffset}, {Names[1]})`)
		Unpacked:Line(`buffer.writef32({SEND_BUFFER}, {Plus(WriteOffset, 4)}, {Names[2]})`)
		Unpacked:Line(`buffer.writef32({SEND_BUFFER}, {Plus(WriteOffset, 8)}, {Names[3]})`)
		Unpacked:End()
	end

	local ReadOffset = Read:Read(12)
	if Mode == "On" then
		local Held = Read:Declare("Vector")
		Read:Line(`{Held} = buffer.readvectorf32x3({RECIEVE_BUFFER}, {ReadOffset})`)
		Read:Line(`{Names[1]}, {Names[2]}, {Names[3]} = {Held}.X, {Held}.Y, {Held}.Z`)
	else
		local Packed = Read:Compare("buffer.readvectorf32x3", "nil", "Not")
		Packed:Line(`local Vector = buffer.readvectorf32x3({RECIEVE_BUFFER}, {ReadOffset})`)
		Packed:Line(`{Names[1]}, {Names[2]}, {Names[3]} = Vector.X, Vector.Y, Vector.Z`)
		local Unpacked = Packed:Branch("Default")
		Unpacked:Line(`{Names[1]} = buffer.readf32({RECIEVE_BUFFER}, {ReadOffset})`)
		Unpacked:Line(`{Names[2]} = buffer.readf32({RECIEVE_BUFFER}, {Plus(ReadOffset, 4)})`)
		Unpacked:Line(`{Names[3]} = buffer.readf32({RECIEVE_BUFFER}, {Plus(ReadOffset, 8)})`)
		Unpacked:End()
	end
end

return Packing
