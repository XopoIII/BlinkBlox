--!strict
--- Fixed text spliced into generated modules, the defaults for the inbound limits, and the inbound
--- guard built from the options.
---
--- Nothing here reads generator state, which is why it can sit apart from the
--- emitter that uses it. Keeping it beside 1500 lines of code-emitting logic made the emitter harder
--- to read for no benefit -- a reader looking for how an event is generated had to scroll past
--- eighty lines of string tables first.

local Grammar = require("../Modules/Grammar")

local EVENTS_TYPE = "BLINK_EVENTS_SYMBOL"
local DIRECTIVES = {
	"--!strict\n",
	"--!native\n",
	"--!optimize 2\n",
	"--!nolint LocalShadow\n",
	"--!nolint LocalUnused\n",
	"--!nolint FunctionUnused\n",
	"--#selene: allow(shadowing)\n",
}
local VERSION_HEADER = {
	`-- File generated by Blink v{_G.VERSION or "0.0.0"} (https://github.com/XopoIII/blink)\n-- This file is not meant to be edited\n\n`,
}

local EVENT_BODY = {
	"RecieveCursor = 0\n",
	"RecieveBuffer = Buffer\n",
	"RecieveInstances = Instances\n",
	"RecieveInstanceCursor = 0\n",
	"local Size = buffer.len(RecieveBuffer)\n",
}

--> INBOUND LIMITS (upstream issue #45). The server parses whatever a client sends in an unbounded
--> `while RecieveCursor < Size` loop, one event per iteration, so a client that sends
--> `buffer.create(1000000)` makes the server decode up to a million events -- each with its own
--> listener dispatch -- inside a single remote callback.
-->
--> The defaults are generous for legitimate traffic: a real client batches a handful of events per
--> frame into a few hundred bytes. Override them per schema when a game genuinely needs more:
-->     option MaxPacketSize = 16384
-->     option MaxEventsPerPacket = 128
-->     option MaxInstancesPerPacket = 512
-->
--> Only the SERVER is guarded. The client trusts the server by construction, and capping the
--> server's own traffic would silently drop legitimate replication.
local DEFAULT_MAX_PACKET_SIZE = Grammar.DEFAULTS.MaxPacketSize
local DEFAULT_MAX_EVENTS_PER_PACKET = 64
local DEFAULT_MAX_INSTANCES_PER_PACKET = 256

--> OUTBOUND UNRELIABLE LIMIT. Roblox drops an UnreliableRemoteEvent payload past roughly this size,
--> silently. The compiler already refuses a schema whose unreliable events cannot fit (see the
--> parser's AnalyzeUnreliableSizes), but a bounded schema can still overflow at runtime -- a map with
--> more entries than expected, a string longer than the game assumed -- and a dropped packet nobody
--> is told about is the worst possible failure mode. This is the runtime half of that check.
local DEFAULT_MAX_UNRELIABLE_SIZE = 900

--- Seconds before an unanswered invocation fails its caller and returns its slot.
---
--- Ten because it has to sit above anything a legitimate handler might do -- a datastore round trip,
--- a marketplace prompt -- and below the point where the caller has given up anyway. Configurable
--- with `option InvocationTimeout` for the handlers that genuinely take longer.
local DEFAULT_INVOCATION_TIMEOUT = 10

local SYNC_VALIDATION_BODY = {
	`local SerdesEvent = "?"\n`,
	"local SerdesThread: thread?\n",
}

--- Detects a Sync listener that yielded, by noticing on the NEXT packet that the previous decode
--- thread is still suspended inside one.
---
--- Two things the old wording left out, both of which cost people time on the devforum thread.
---
--- It fires when the next packet arrives, not when the yield happens -- so a listener that yields
--- with no further traffic behind it is never reported, which is why "I added yielding callbacks and
--- got no error" is a correct observation rather than a broken check.
---
--- And `coroutine.close` does not merely end the warning: it destroys the suspended decode, so every
--- event still unread in that earlier packet is thrown away. The warning now says so. Silently
--- losing events while reporting only a style preference is the wrong way round.
local EVENT_SYNC_VALIDATION = {
	`if SerdesThread and coroutine.status(SerdesThread) == "suspended" then\n`,
	'\twarn(`[Blink]: Event "{SerdesEvent}" yielded in a Sync call, so the rest of the packet it arrived in was discarded. Use an Async call if the listener needs to yield.`)\n',
	"\tcoroutine.close(SerdesThread)\n",
	"end\n",
	"SerdesThread = coroutine.running()\n",
}

local RELIABLE_BODY = {
	Header = "local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances",
	Body = {
		"Load(PlayersMap[Player])\n",
		"local Position = Allocate(Size)\n",
		"buffer.copy(SendBuffer, Position, Buffer, 0, Size)\n",
		"table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)\n",
		"SavePlayerBuffer(Player)\n",
	},
}

local UNRELIABLE_BODY = {
	"local Buffer = buffer.create(SendCursor)\n",
	"buffer.copy(Buffer, 0, SendBuffer, 0, SendCursor)\n",
}

local IGNORED_TYPES_IN_SHARED = {
	Event = true,
	Function = true,
}

--- The guard at the top of each server connection, rejecting a hostile packet before any of it is
--- parsed. It reads the arguments the remote handed over, so it runs before EVENT_BODY copies them
--- into the module-level cursors.
---
--- The order is deliberate. The TYPES first: nothing stops a client from calling FireServer with
--- arguments of its own choosing, `buffer.len` on a string throws from inside the connection itself
--- where no listener's pcall can reach it, and the signature is a promise the client never made.
--- Then the SIZE, so the budget is never charged more than MaxPacketSize and a burst of at least that
--- always has room for one packet. Then the BUDGET (see InboundAccept in the server template), and
--- only then anything that costs work in proportion to what was sent.
local function InboundGuard(Options: Grammar.Options): { string }
	local MaxPacketSize = Options.MaxPacketSize or DEFAULT_MAX_PACKET_SIZE
	local MaxInstances = Options.MaxInstancesPerPacket or DEFAULT_MAX_INSTANCES_PER_PACKET
	local Rate = Options.InboundBytesPerSecond or (MaxPacketSize * Grammar.DEFAULTS.InboundRatePackets)
	local Burst = Options.InboundBurst or math.max(Rate, MaxPacketSize)
	local Floor = Grammar.DEFAULTS.InboundFloor

	return {
		'if typeof(Buffer) ~= "buffer" or type(Instances) ~= "table" then\n',
		"\twarn(`[Blink]: Dropped a malformed packet from {Player.Name}.`)\n",
		"\treturn\n",
		"end\n",
		`if buffer.len(Buffer) > {MaxPacketSize} then\n`,
		"\twarn(`[Blink]: Dropped an oversized packet from {Player.Name}.`)\n",
		"\treturn\n",
		"end\n",
		`if not InboundAccept(Player, math.max(buffer.len(Buffer), {Floor}), {Rate}, {Burst}) then\n`,
		"\treturn\n",
		"end\n",
		`if #Instances > {MaxInstances} then\n`,
		"\twarn(`[Blink]: Dropped a packet with too many instances from {Player.Name}.`)\n",
		"\treturn\n",
		"end\n",
	}
end

--> CFrame<quat>. Spliced in only when a schema uses it; see `Prefabs.Required`.
-->
--> The quaternion comes from the rotation matrix by the trace branch -- `ToAxisAngle` is ill-conditioned
--> near 0 and pi -- and is normalised, so a CFrame that is not quite orthonormal still encodes. q and
--> -q are the same rotation, so the one dropped is made positive and only the other three travel,
--> each within +-1/sqrt(2) and scaled to fill an i16. The reader rebuilds the fourth, clamped at zero
--> since a hostile packet can send three that square to more than one, and refuses an index past 3.
local ROTATION_HELPERS = {
	"\n",
	"local ROTATION_SCALE = 32767 * math.sqrt(2)\n",
	"local function PackRotation(Value: CFrame): (number, number, number, number)\n",
	"\tlocal _, _, _, R00, R01, R02, R10, R11, R12, R20, R21, R22 = Value:GetComponents()\n",
	"\tlocal X, Y, Z, W\n",
	"\tlocal Trace = R00 + R11 + R22\n",
	"\tif Trace > 0 then\n",
	"\t\tlocal S = math.sqrt(Trace + 1) * 2\n",
	"\t\tX, Y, Z, W = (R21 - R12) / S, (R02 - R20) / S, (R10 - R01) / S, 0.25 * S\n",
	"\telseif R00 > R11 and R00 > R22 then\n",
	"\t\tlocal S = math.sqrt(1 + R00 - R11 - R22) * 2\n",
	"\t\tX, Y, Z, W = 0.25 * S, (R01 + R10) / S, (R02 + R20) / S, (R21 - R12) / S\n",
	"\telseif R11 > R22 then\n",
	"\t\tlocal S = math.sqrt(1 + R11 - R00 - R22) * 2\n",
	"\t\tX, Y, Z, W = (R01 + R10) / S, 0.25 * S, (R12 + R21) / S, (R02 - R20) / S\n",
	"\telse\n",
	"\t\tlocal S = math.sqrt(1 + R22 - R00 - R11) * 2\n",
	"\t\tX, Y, Z, W = (R02 + R20) / S, (R12 + R21) / S, 0.25 * S, (R10 - R01) / S\n",
	"\tend\n",
	"\tlocal Length = math.sqrt(X * X + Y * Y + Z * Z + W * W)\n",
	"\tif not (Length > 0 and Length < math.huge) then\n",
	'\t\terror("Expected a CFrame with a valid rotation.")\n',
	"\tend\n",
	"\tlocal Index, A, B, C, Largest = 0, Y, Z, W, X\n",
	"\tif math.abs(Y) > math.abs(Largest) then\n",
	"\t\tIndex, A, B, C, Largest = 1, X, Z, W, Y\n",
	"\tend\n",
	"\tif math.abs(Z) > math.abs(Largest) then\n",
	"\t\tIndex, A, B, C, Largest = 2, X, Y, W, Z\n",
	"\tend\n",
	"\tif math.abs(W) > math.abs(Largest) then\n",
	"\t\tIndex, A, B, C, Largest = 3, X, Y, Z, W\n",
	"\tend\n",
	"\tlocal Scale = (if Largest < 0 then -ROTATION_SCALE else ROTATION_SCALE) / Length\n",
	"\treturn Index,\n",
	"\t\tmath.clamp(math.round(A * Scale), -32767, 32767),\n",
	"\t\tmath.clamp(math.round(B * Scale), -32767, 32767),\n",
	"\t\tmath.clamp(math.round(C * Scale), -32767, 32767)\n",
	"end\n",
	"local function UnpackRotation(X: number, Y: number, Z: number, Index: number, A: number, B: number, C: number): CFrame\n",
	"\tif Index > 3 then\n",
	"\t\terror(`Expected a rotation index from 0 to 3, got {Index} instead.`)\n",
	"\tend\n",
	"\tA, B, C = A / ROTATION_SCALE, B / ROTATION_SCALE, C / ROTATION_SCALE\n",
	"\tlocal D = math.sqrt(math.max(0, 1 - A * A - B * B - C * C))\n",
	"\tlocal Length = math.sqrt(A * A + B * B + C * C + D * D)\n",
	"\tA, B, C, D = A / Length, B / Length, C / Length, D / Length\n",
	"\tif Index == 0 then\n",
	"\t\treturn CFrame.new(X, Y, Z, D, A, B, C)\n",
	"\telseif Index == 1 then\n",
	"\t\treturn CFrame.new(X, Y, Z, A, D, B, C)\n",
	"\telseif Index == 2 then\n",
	"\t\treturn CFrame.new(X, Y, Z, A, B, D, C)\n",
	"\tend\n",
	"\treturn CFrame.new(X, Y, Z, A, B, C, D)\n",
	"end\n",
}

return {
	EVENTS_TYPE = EVENTS_TYPE,
	ROTATION_HELPERS = ROTATION_HELPERS,
	InboundGuard = InboundGuard,
	DIRECTIVES = DIRECTIVES,
	VERSION_HEADER = VERSION_HEADER,
	EVENT_BODY = EVENT_BODY,
	DEFAULT_MAX_PACKET_SIZE = DEFAULT_MAX_PACKET_SIZE,
	DEFAULT_MAX_EVENTS_PER_PACKET = DEFAULT_MAX_EVENTS_PER_PACKET,
	DEFAULT_MAX_INSTANCES_PER_PACKET = DEFAULT_MAX_INSTANCES_PER_PACKET,
	DEFAULT_MAX_UNRELIABLE_SIZE = DEFAULT_MAX_UNRELIABLE_SIZE,
	DEFAULT_INVOCATION_TIMEOUT = DEFAULT_INVOCATION_TIMEOUT,
	SYNC_VALIDATION_BODY = SYNC_VALIDATION_BODY,
	EVENT_SYNC_VALIDATION = EVENT_SYNC_VALIDATION,
	RELIABLE_BODY = RELIABLE_BODY,
	UNRELIABLE_BODY = UNRELIABLE_BODY,
	IGNORED_TYPES_IN_SHARED = IGNORED_TYPES_IN_SHARED,
}
