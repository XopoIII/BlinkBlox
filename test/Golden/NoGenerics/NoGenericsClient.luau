			local Key_2 = true :: any
			local OFFSET_0 = Read(1)
			BITFIELD_3_0 = buffer.readu8(RecieveBuffer, OFFSET_0)
			local Index = bit32.extract(BITFIELD_3_0, 0, 2)
			if Index == 0 then
				Key_2 = "A"
			elseif Index == 1 then
				Key_2 = "B"
			elseif Index == 2 then
				Key_2 = "C"
			elseif Index == 3 then
				Key_2 = "D"
			else
				error(`Unexpected enum: {Index}`)
			end
			-- Element_2: MapReference
			local Element_2 = true :: any
			local Index = bit32.extract(BITFIELD_3_0, 2, 2)
			if Index == 0 then
				Element_2 = "A"
			elseif Index == 1 then
				Element_2 = "B"
			elseif Index == 2 then
				Element_2 = "C"
			elseif Index == 3 then
				Element_2 = "D"
			else
				error(`Unexpected enum: {Index}`)
			end
			Value[Key_2] = Element_2
		end
	end
	return Value
end

