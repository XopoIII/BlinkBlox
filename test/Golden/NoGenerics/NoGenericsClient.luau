function SerdesFunctions.ReadEVENT_Reference(): ({ Field: number?, Float16Field: number?, Enum: ("A" | "B" | "C" | "D"), Nested: { Guh: number, Array: { number }, OptionalArray: { number }? } }?)
	-- Read BLOCK: 1 bytes
	local BLOCK_START = Read(1)
	-- Value: Reference
	local Value
	local BITFIELD_0 = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if bit32.btest(BITFIELD_0, 0x01) == true then
		-- Read BLOCK: 3 bytes
		local BLOCK_START = Read(3)
		-- Value: Reference
		Value = {} :: any
		-- Value.Field: Field
		local BITFIELD_0 = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
		if bit32.btest(BITFIELD_0, 0x01) == true then
			-- Read BLOCK: 1 bytes
			local BLOCK_START = Read(1)
			-- Value.Field: Field
			Value.Field = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
		end
		-- Value.Float16Field: Float16Field
		if bit32.btest(BITFIELD_0, 0x02) == true then
			-- Read BLOCK: 2 bytes
			local BLOCK_START = Read(2)
			-- Value.Float16Field: Float16Field
			local Encoded = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
			local MantissaExponent = Encoded % 0x8000
			if MantissaExponent == 0b0_11111_0000000000  then
				if Encoded // 0x8000 == 1 then
					Value.Float16Field = -math.huge
				else
					Value.Float16Field = math.huge
				end
			elseif MantissaExponent > 0b0_11111_0000000000 then
				Value.Float16Field = 0 / 0
			elseif MantissaExponent == 0b0_00000_0000000000   then
				Value.Float16Field = 0
			else
				local Mantissa = MantissaExponent % 0x400
				local Exponent = MantissaExponent // 0x400
				local Fraction;
				if Exponent == 0 then
					Fraction = Mantissa / 0x400
				else
					Fraction = Mantissa / 0x800 + 0.5
				end
				local Result = math.ldexp(Fraction, Exponent - 14)
				Value.Float16Field = if Encoded // 0x8000 == 1 then -Result else Result
			end
		end
		-- Value.Enum: Enum
		Value.Enum = true :: any
		local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 1)
		if Index == 0 then
			Value.Enum = "A"
		elseif Index == 1 then
			Value.Enum = "B"
		elseif Index == 2 then
