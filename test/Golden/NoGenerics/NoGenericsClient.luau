	BITFIELD_1_0 = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if bit32.btest(BITFIELD_1_0, 0x01) then
		-- Read BLOCK: 2 bytes
		local BLOCK_START = Read(2)
		-- Value: MapReference
		Value = {} :: { [any]: any }
