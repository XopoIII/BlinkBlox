struct Shape1 { id: u16, name: string(..255), owner: Instance(Player) }

event Equip {
	-- TODO(convert): QuickNet does not say which side sends this; say it here
	From: Client,
	Type: Reliable,
	Call: ManyAsync,
	Rate: 10,
	Data: (u8, Shape1)
}

