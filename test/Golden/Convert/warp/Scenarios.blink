	-- TODO(convert): Warp does not say which side sends this; say it here
	From: Client,
	-- TODO(convert): Warp does not say whether this is reliable; say it here
	Type: Reliable,
	Call: ManyAsync,
	-- TODO(convert): Rate: ?, Burst: ?
	Data: struct { jump: boolean, move: u8, sprint: boolean, turn: i16 }
}

