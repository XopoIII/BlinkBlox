    if not Times then
        if Player.Parent == nil then
            return false
        end

        Times = {}
        Reports[Player] = Times
    end

    local Now = os.clock()
    local Last = Times[Kind]
    if Last ~= nil and (Now - Last) < 1 then
        return false
    end

    Times[Kind] = Now
    return true
end

