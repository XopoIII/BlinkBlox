		buffer.writeu16(SendBuffer, BLOCK_START + 1, 0b1_11111_0000000001)
	elseif Value == 0 then
		buffer.writeu16(SendBuffer, BLOCK_START + 1, if 1 / Value < 0 then 0x8000 else 0)
