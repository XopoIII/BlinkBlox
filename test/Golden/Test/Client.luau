function SerdesFunctions.Indexers_ReadEVENT_TestEvent(): ({ ["z z"]: number, ["1 1"]: number, ["2 2"]: number, ["3 3"]: number }, {["a a"]: boolean,}, ("b b"), { Type: "c c", Test: number })
	-- Read BLOCK: 6 bytes
	local BLOCK_START = Read(6)
	local BITFIELD_1_0
	local RecieveBuffer = RecieveBuffer
	-- Value: TestEvent
	-- Value1: TestEvent
	local Value1 = {["z z"] = false, ["1 1"] = false, ["2 2"] = false, ["3 3"] = false} :: any
	-- Value1["z z"]: z z
	Value1["z z"] = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	-- Value1["1 1"]: 1 1
	Value1["1 1"] = buffer.readu8(RecieveBuffer, BLOCK_START + 1)
	-- Value1["2 2"]: 2 2
	Value1["2 2"] = buffer.readu8(RecieveBuffer, BLOCK_START + 2)
	-- Value1["3 3"]: 3 3
	Value1["3 3"] = buffer.readu8(RecieveBuffer, BLOCK_START + 3)
	-- Value2: TestEvent
	local Value2 = {}
	local SET_BITS = buffer.readu8(RecieveBuffer, BLOCK_START + 4)
	Value2["a a"] = bit32.btest(SET_BITS, 0x1);
	-- Value3: TestEvent
	local Value3 = true :: any
	BITFIELD_1_0 = buffer.readu8(RecieveBuffer, BLOCK_START + 5)
	local Index = bit32.extract(BITFIELD_1_0, 0, 1)
	if Index == 0 then
		Value3 = "b b"
	else
		error(`Unexpected enum: {Index}`)
	end
	-- Value4: TestEvent
	local Tag = bit32.extract(BITFIELD_1_0, 1, 1)
	local Value4 = true :: any
	if Tag == 0 then
		-- Read BLOCK: 1 bytes
		local BLOCK_START = Read(1)
		-- Value4: c c
		Value4 = {Test = false} :: any
		-- Value4.Test: Test
		Value4.Test = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
		Value4.Type = "c c"
	else
		error(`Unexpected variant: {Tag}`)
	end
	return Value1, Value2, Value3, Value4
end

function SerdesFunctions.WriteEVENT_OrderedPosition(Value: number): ()
