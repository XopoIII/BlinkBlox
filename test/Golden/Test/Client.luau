function SerdesFunctions.ReadEVENT_PlayerEvent(): ({ Type: "Join", Name: string, UserId: number } | { Type: "Chat", UserId: number, Message: string } | { Type: "Leave", UserId: number })
	-- Read BLOCK: 1 bytes
	local BLOCK_START = Read(1)
	-- Value: PlayerEvent
	local Tag = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	local Value = true :: any
	if Tag == 0 then
		-- Read BLOCK: 10 bytes
		local BLOCK_START = Read(10)
		-- Value: Join
		Value = {} :: any
		-- Value.Name: Name
		local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
		Value.Name = buffer.readstring(RecieveBuffer, Read(Length), Length)
		-- Value.UserId: UserId
		Value.UserId = buffer.readf64(RecieveBuffer, BLOCK_START + 2)
		Value.Type = "Join"
	elseif Tag == 1 then
		-- Read BLOCK: 10 bytes
		local BLOCK_START = Read(10)
		-- Value: Chat
		Value = {} :: any
		-- Value.UserId: UserId
		Value.UserId = buffer.readf64(RecieveBuffer, BLOCK_START + 0)
		-- Value.Message: Message
		local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 8)
		Value.Message = buffer.readstring(RecieveBuffer, Read(Length), Length)
		Value.Type = "Chat"
	elseif Tag == 2 then
		-- Read BLOCK: 8 bytes
		local BLOCK_START = Read(8)
		-- Value: Leave
		Value = {} :: any
		-- Value.UserId: UserId
		Value.UserId = buffer.readf64(RecieveBuffer, BLOCK_START + 0)
		Value.Type = "Leave"
	else
		error(`Unexpected variant: {Tag}`)
	end
	return Value
end

function SerdesFunctions.WriteEVENT_Booleans(Value: { boolean }): ()
	-- Allocate BLOCK: 3 bytes
	local BLOCK_START = Allocate(3)
	-- EVENT_Booleans (16)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 16)
	-- Value: Booleans
	-- START ARRAY
	buffer.writeu16(SendBuffer, BLOCK_START + 1, #Value)
		-- Allocate BLOCK: 1 bytes
	local ARRAY_START_1 = Allocate(1 * #Value)
	for Index = 1, #Value do
		local Item_1 = Value[Index]
		-- Item_1: Booleans
		if typeof(Item_1) ~= "boolean" then
			error(`Expected Item_1 to be of type boolean, got {type(Item_1)} instead.`)
		end
		-- Allocate 1
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_0, Item_1 and 1 or 0)
	end
	-- END ARRAY
end

function SerdesFunctions.ReadEVENT_Generic(): ({ Data: number, Array: { number }, Optional: number?, Nested: { Value: number } })
	-- Read BLOCK: 5 bytes
	local BLOCK_START = Read(5)
	-- Value: Generic
	local Value = {} :: any
	-- Value.Data: Data
	Value.Data = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	-- Value.Array: Array
	-- START ARRAY
	local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 1)
	if Length < 0 then error(`Expected "Length" to be larger than 0, got {Length} instead.`) end
	if Length > 65535 then error(`Expected "Length" to be smaller than 65535, got {Length} instead.`) end
	Value.Array = table.create(Length)
		-- Read BLOCK: 1 bytes
	local ARRAY_START_1 = Read(1 * Length)
	for Index = 1, Length do
		-- Item_1: Array
		-- Read 1
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 1
		local Item_1 = buffer.readu8(RecieveBuffer, OPERATION_OFFSET_0)
		table.insert(Value.Array, Item_1)
	end
	-- END ARRAY
	-- Value.Optional: Optional
	if buffer.readu8(RecieveBuffer, BLOCK_START + 3) == 1 then
		-- Read BLOCK: 1 bytes
		local BLOCK_START = Read(1)
		-- Value.Optional: Optional
		Value.Optional = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	end
	-- Value.Nested: Nested
	Value.Nested = {} :: any
	-- Value.Nested.Value: Value
	Value.Nested.Value = buffer.readu8(RecieveBuffer, BLOCK_START + 4)
	return Value
end

