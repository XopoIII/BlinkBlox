			buffer.writeu8(SendBuffer, OPERATION_OFFSET_0, Item_1)
		end
		-- END ARRAY
	end
	-- Value.Optional: Optional
	BITFIELD_0 = 0
	if Value.Optional ~= nil then BITFIELD_0 += 0x01 end
	if Value.Optional ~= nil then
		-- Allocate BLOCK: 1 bytes
		local BLOCK_START = Allocate(1)
		-- Value.Optional: Optional
