option Casing = Pascal
option Typescript = true
option TypesOutput = "../../Network/Types.luau"
option ClientOutput = "../../Network/Client.luau"
option ServerOutput = "../../Network/Server.luau"
option SyncValidation = true
option WriteValidations = true
option ManualReplication = false
option Predict = true
--> Above the one-second yield the RemoteFunction specs use, and low enough that the timeout spec
--> does not add ten seconds to every run.
option InvocationTimeout = 3
--> Compiled as release, so this never applies -- and if it did, a one-byte packet cap would break
--> every spec in the suite, which is how the goldens and the run both notice a profile leaking.
@profile("dev")
option MaxPacketSize = 1

import "./Indexers"
import "./Sub-Sources/Source"
import "./Sub-Sources/Source" as ImportA

struct ImportReference {
    A: ImportA.a,
    B: Source.a
}

type A = CFrame
type B = CFrame[..10]
type C = CFrame?
type D = Color3

export type Byte = u8

export type Color = Color3
export type ColorArray = Color3[]
export type DateSeconds = DateTime
export type DateMilliseconds = DateTimeMillis
export type BrickkColor = BrickColor

export type ExactRange = f32(0)
export type DecimalRange = f32(-5.5..10.5)
export type NegativeRange = i8(-5..10)
export type UnboundUpper = f32(-0.0..)
export type UnboundLower = f32(..-0.0)
export type RangedVector = vector(0..1)

export type Buffer = buffer
export type ExactBuffer = buffer(9)
export type BoundedBuffer = buffer(0..1000)

type IntegerVector = vector<i16>
type HalfPrecisionCFrame = CFrame<f32, f16>

-- Fixtures for CFrame encodings: the default, the quaternion rotation in either slot, and one
-- inside an array, where its locals are declared once per element.
export type PlainCFrame = CFrame
export type QuatCFrame = CFrame<quat>
export type QuatHalfCFrame = CFrame<f16, quat>
export type QuatFirstCFrame = CFrame<quat, f16>
export type QuatCFrames = CFrame<quat>[]

type InstanceArray = Instance(Sound)[10]
type InstanceArrayOptional = Instance(Sound)[10]?
type ConstrainedArray = u8(0..10)[10]

export type MultiDimensionalArray = u8[][][]

-- Fixtures for the static size analysis. Each one exercises a branch of src/Modules/Size.luau, and
-- the suite checks the measured bounds against the byte length the emitter actually produces.
export type SizeByte = u8
export type SizeFixedString = string(8)
export type SizeBoundedString = string(0..64)
export type SizeFixedArray = u8[4]
export type SizeBoundedArray = u16[0..10]
export type SizeOptionalByte = u8?
export type SizeVector = vector
export struct SizeStruct {
    A: u8,
    B: boolean,
    C: u16,
}
export enum SizeEnum = {A, B, C}
export set SizeFlags = {F1, F2, F3}
export map SizeMap = {[u8]: u16}

-- An ordered unreliable event: delivery is still not guaranteed, but a packet that arrives after a
-- newer one is discarded instead of applied out of order.
event OrderedPosition {
    From: Client,
    Type: OrderedUnreliable,
    Call: SingleSync,
    Data: u8,
}

-- Fixtures for offset-encoded lengths. A span of a hundred fits in one byte however high the bounds
-- sit, so these cost one byte of length where they used to cost two.
export type OffsetArray = u8[300..400]
export type OffsetString = string(300..400)
export type OffsetBuffer = buffer(300..400)

-- Fixtures for bit packing. The interesting numbers are the ones either side of a byte boundary:
-- one bit and seven bits still cost a byte, eight exactly fill it, nine spill into a second.
export struct BitsOne {
    A: boolean,
}

export struct BitsSeven {
    A: boolean,
    B: boolean,
    C: boolean,
    D: boolean,
    E: boolean,
    F: boolean,
    G: boolean,
}

export struct BitsEight {
    A: boolean,
    B: boolean,
    C: boolean,
    D: boolean,
    E: boolean,
    F: boolean,
    G: boolean,
    H: boolean,
}

export struct BitsNine {
    A: boolean,
    B: boolean,
    C: boolean,
    D: boolean,
    E: boolean,
    F: boolean,
    G: boolean,
    H: boolean,
    I: boolean,
}

export struct BitsSeventeen {
    A: boolean,
    B: boolean,
    C: boolean,
    D: boolean,
    E: boolean,
    F: boolean,
    G: boolean,
    H: boolean,
    I: boolean,
    J: boolean,
    K: boolean,
    L: boolean,
    M: boolean,
    N: boolean,
    O: boolean,
    P: boolean,
    Q: boolean,
}

-- Booleans and optional presence flags share the same bitfield: four flags, one byte, plus whatever
-- the present payloads cost.
export struct BitsMixed {
    A: boolean,
    B: u8?,
    C: boolean,
    D: u16?,
}

-- Fixtures for packed boolean arrays: eight elements to a byte, after the length. Beside plain
-- booleans, inside a map and nested, the run must not disturb the bitfield or the block around it.
type PackedAlias = boolean
export type PackedBooleans = boolean[]
export type PackedFixed = boolean[10]
export type PackedRanged = boolean[3..20]
export type PackedNested = boolean[][]
export type PackedThroughAlias = PackedAlias[]
export struct PackedBeside {
    A: boolean,
    List: boolean[],
    B: boolean,
    Fixed: boolean[3],
    C: u8,
}
export map PackedMap = {[string]: boolean[]}
export type PackedOptional = boolean?[]

-- Fixtures for rate limiting. Rate is events per second and Burst is the bucket capacity, so
-- "Burst" of them arrive at once and the rest need the clock to move.
event RateLimited {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Rate: 5,
    Burst: 10,
    Data: u8,
}

event RateLimitedPoll {
    From: Client,
    Type: Reliable,
    Call: Polling,
    Rate: 5,
    Burst: 10,
    Data: u8,
}

-- An unbounded string over an unreliable channel: the compiler warns (W3019) and the runtime guard
-- catches the payloads that actually overflow.
event UnreliableOversize {
    From: Client,
    Type: Unreliable,
    Call: SingleSync,
    Data: string,
}

-- Each Instance sent beside the buffer costs the unreliable payload 6 bytes, so a buffer that fits
-- alone can overflow with Instances beside it: the compiler warns (W3019) and the runtime guard counts
-- them.
event UnreliableInstances {
    From: Client,
    Type: Unreliable,
    Call: SingleSync,
    Data: (buffer(0..970), Instance[0..4])
}

function RateLimitedCall {
    Yield: Coroutine,
    Rate: 2,
    Burst: 2,
    Data: u8,
    Return: u8,
}

function ConcurrentCall {
    Yield: Coroutine,
    Concurrency: 2,
    Data: u8,
    Return: u8,
}

enum States = { A, B, C, D }

set Flags8 = {F1, F2, F3, F4, F5, F6, F7, F8}
set Flags16 = {F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15, F16}
set Flags32 = {F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15, F16, F17, F18, F19, F20, F21, F22, F23, F24, F25, F26, F27, F28, F29, F30, F31, F32}
set Flags33 = {F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15, F16, F17, F18, F19, F20, F21, F22, F23, F24, F25, F26, F27, F28, F29, F30, F31, F32, F33}

struct StructOfFlags {
    A: set {Flag, Flag1},
    B: set {Flag, Flag1},
    C: set {Flag, Flag1},
}

map MapSimple = {[string]: u8}
map MapComplex = {[string(0..20)]: u8(0..100)[8]}
map MapReference = {[States]: States}?
export map MapNested = {[string]: MapSimple}

map ArrayMap = {[u8]: u8}[0..20]
enum ArrayEnum = {A, B, C}[0..20]
struct ArrayStruct {

}[0..20]

struct Generic<A, B, C> {
    Data: A,
    Array: A[],
    Optional: C?,
    Nested: struct {
        Value: B
    }
}

type struct = u8
struct Conflict {
    type: u8
}

enum Event = "Type" {
    Join {
        Name: string,
        UserId: f64,
    },
    Chat {
        UserId: f64,
        Message: string
    },
    Leave {
        UserId: f64
    }
}

type Float16 = f16

export struct Standalone {
    One: u8,
    Two: u8,
    Three: u8,
    Event: Event,
    Nested: struct {
        Four: string,
        Five: string
    }
}

type Number = u8
struct Example {
    Field: u8?,
    Float16Field: f16?,
    Enum: States,
    Nested: struct {
        Guh: u8,
        Array: u8[10],
        OptionalArray: u8[2]?
    }
}

set PrimitiveFlag = {
    CFrame
}

enum PrimitiveEnum = {
    CFrame
}

enum PrimitiveTagEnum = "Type" {
    CFrame {}
}

struct PrimitiveField {
    CFrame: u8
}

map GenericMap<K, V> = {[K]: V}

struct GenericMerge<A, B> {
    Map: GenericMap<string, B>,
    Data: A,
    Struct: Generic<u8, string, B[]>,
    AnotherNested: struct {
        Value: B
    }
}

struct MergeStruct {
    ..Example,
    ..GenericMerge<u8, f64>
}

struct MapStruct {
    Map: map {[string]: u8}
}

event SendOccupiedCell {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: IntegerVector
}

