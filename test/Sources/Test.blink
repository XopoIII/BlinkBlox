-- Class names containing a digit used to fail to lex (issue #75). Vector3Value and Motor6D are real
-- Roblox classes, and the digit sits in the middle and at the end respectively.
type Vector3ValueRef = Instance(Vector3Value)

event InstanceOfClassWithDigit {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: Instance(Motor6D)
}

event Reference {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: Example?
}

event ReferenceArray {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: Example[8]
}

event ReferenceOptional {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: Example?
}

function RemoteFunction {
    Yield: Coroutine,
    Data: u8,
    Return: u8
}

event Tuple {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: (u8, States, u16?, Instance, Instance?, u8[8])
}

event TupleUnreliable {
    From: Server,
    Type: Unreliable,
    Call: SingleSync,
    Data: (u8, States, u16?, Instance, Instance?)
}

function TupleFunction {
    Yield: Coroutine,
    Data: (u8, States, u16?, Instance, Instance?),
    Return: (Instance?, Instance, u16?, States, u8)
}

scope AnotherScope {
    event InScopeEvent {
        From: Server,
        Type: Reliable,
        Call: SingleSync,
        Data: u8
    }

    scope ScopeWithinAnotherScope {
        type ExampleType = u8
        event InAnotherScopeEvent {
            From: Server,
            Type: Reliable,
            Call: SingleSync,
            Data: ExampleType
        }
    }
}

scope ExampleScope {
    event InScopeEvent {
        From: Server,
        Type: Reliable,
        Call: SingleSync,
        Data: AnotherScope.ScopeWithinAnotherScope.ExampleType
    }
}

scope Issue33 {
    enum Foo = {
        One,
        Two
    }

    map Map<T> = {[Foo]: f64}

    enum Enum<T> = "Tag" {
        Variant {
            field: Foo
        }
    }

    struct Struct<T> {
        field: Foo
    }

    event Event {
        From: Server,
        Type: Reliable,
        Call: SingleSync,
        Data: (Map<u8>, Enum<u8>, Struct<u8>)
    }
}
--> An inbound `unknown`, so the suite can replay a packet whose instance table is short of what the
--> buffer claims. Declared last so the event indices above keep their numbers.
event UnknownInbound {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: unknown,
}

--> Named type-pack elements. Declared last, like UnknownInbound above, so the event indices already
--> recorded in the goldens keep their numbers.
event NamedTuple {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: (chefId: f64, dish: string, portions: u8?)
}

--> Data and Return deliberately reuse the same names. The two packs share a scope in the generated
--> body, so this is what proves the Return prefix keeps them apart.
function NamedTupleFunction {
    Yield: Coroutine,
    Data: (id: u8, label: string),
    Return: (id: u16, label: string)
}

--> A pack may be named in part.
event PartiallyNamedTuple {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: (u8, named: string, u16)
}

--> Nothing ever listens to this one, which is the point: it is how the suite exercises an invocation
--> that is never answered. Declared last so the indices above keep their numbers.
function NeverAnswered {
    Yield: Coroutine,
    Data: u8,
    Return: u8
}

--> A function the SERVER invokes: the client listens, and the server names which client it is asking.
--> Declared last so the indices above keep their numbers.
function AskClient {
    From: Server,
    Yield: Coroutine,
    Data: u8,
    Return: u8
}

--> Ranges on data a CLIENT chooses. Every other ranged declaration in this schema is either an
--> exported type -- whose Read and Write are a standalone pair with no direction -- or attached to a
--> server-to-client event, so the one direction the fork exists to defend was the one direction with
--> no fixture: a bound checked against bytes an attacker picked. Declared last so the indices above
--> keep their numbers.
event RangedFromClient {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: u8(10..20)
}

event RangedUnreliableFromClient {
    From: Client,
    Type: Unreliable,
    Call: SingleSync,
    Data: u8(10..20)
}

--> A ranged vector sent by a client, so its magnitude assert runs on the path a client controls.
event RangedVectorFromClient {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: vector(0..1)
}

--> For the reply that cannot be serialised: the suite installs a listener returning the wrong type,
--> which throws inside the return serialiser rather than inside the listener.
function BadlyAnswered {
    Yield: Coroutine,
    Data: u8,
    Return: u8
}

--> An UNRANGED payload, which is what makes the corruption visible. The event id is written before
--> the field is validated, so a rejected write leaves a phantom event in the batch carrying whatever
--> the payload byte happened to hold. On a ranged field the receiver's own bound rejects that
--> phantom and hides the bug; on this one it is delivered as an ordinary value nobody sent.
event PlainFromClient {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: u8
}

--> Never listened to by any spec: the server's queue for it is what a client fills when a game
--> declares an event it does not handle, and it has to stop growing at the cap.
event Unlistened {
    From: Client,
    Type: Reliable,
    Call: SingleAsync
}

--> The same for an invocation, whose caller has to be answered once the queue is full.
function Unanswered {
    Yield: Coroutine
}

--> None of these may reach the goldens: the suite compiles without `--profile`, which is release.
@profile("dev")
struct DevOnlyGrant {
    Amount: u32
}

@profile("dev")
event DevOnlyGiveMoney {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: DevOnlyGrant
}

@profile("dev")
scope DevOnlyDebug {
    event Pause {
        From: Client,
        Type: Reliable,
        Call: SingleSync
    }
}

--> A tuple that ends on a nil, arriving before its listener. The queue used to store it as a table
--> literal and replay it with `table.unpack`, which stops at the first border `#` finds -- here 1.
event QueuedHoles {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: (u8, u8?, u8?, u8, u8?)
}

--> Ordered from the server, which stamps each player's own sequence number into each send.
event OrderedToClient {
    From: Server,
    Type: OrderedUnreliable,
    Call: SingleSync,
    Data: u8
}

--> An array of optional elements with a hole in it. The reader inserted each element, and inserting a
--> nil does nothing, so every element after the hole arrived one place early.
export type OptionalHoles = u8?[3]

--> A half-precision float with a public reader and writer, for the edge cases of the encoding: NaN,
--> the infinities, and the subnormal that rounds up to the smallest normal number.
export type HalfFloat = f16

--> The 24-bit numbers, with public readers and writers. Floats24.luau reads every f24 pattern there
--> is through `Float24`; the vector and the CFrame are there for their sizes, 9 and 16 bytes.
export type Float24 = f24
export type Unsigned24 = u24
export type Signed24 = i24
export type Vector24 = vector<f24>
export type QuatCFrame24 = CFrame<f24, quat>

--> Float ranges whose bounds the encoding cannot hold exactly. 0.3 is 0.30000001192092896 as an f32,
--> above its own bound, and 0.1 as an f16 is 0.0999755859375, below it; the receiver has to check
--> against the bounds as they would arrive, or it refuses the very values the range names.
event RangedFloat32 {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: f32(0..0.3)
}

event RangedFloat16 {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: f16(0.1..1)
}

--> Pack elements named after the serialisers' own locals. A string's writer declares `local Length`,
--> which shadowed an element called Length, and the u16 went out as the string's length.
event NamedLength {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: (s: string, Length: u16)
}

event LengthFirst {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: (Length: u16, s: string)
}

--> Flags named after locals the readers after them declare. Each flag was recorded as a declared
--> variable, so the string's reader assigned `Length` without `local` -- a global write.
set CollidingFlags = { Length, Index }
export struct FlagCarrier {
    Flags: CollidingFlags,
    Text: string,
    Kind: enum { A, B },
}

--> f24 rounds to nearest where f16 truncates, so its bounds can narrow either way: 0.1 arrives a
--> little below itself, and 0.7 a little above. The receiver checks the bounds narrowed the same way.
event RangedFloat24 {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: f24(0.1..0.7)
}
