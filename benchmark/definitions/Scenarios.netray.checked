-- Scenarios.netray as a live server would configure NetRay: validation on, budgets on, nothing
-- refused, and its opt-in delta compression on the one event it fits -- Snapshot is reliable and
-- carries no Instance, where Touch's passthrough rules compression out. The payloads differ per
-- index, so Repeat finds little to repeat; the table says what it cost.
option DecodeStruct = Table;
option Validate = Full;
option MaxBatchBytes = 2097152;
option MaxBatchMessages = 2048;
option MaxDecodeWork = 2147483647;
option MaxUnreliableBytes = 1000;
option MaxPollingMessages = 128;
option ReceiveCallsPerSecond = 100000;
option ReceiveCallBurst = 100000;
option ReceiveBytesPerSecond = 67108864;
option ReceiveByteBurst = 67108864;
option ReceiveMessagesPerSecond = 1000000;
option ReceiveMessageBurst = 1000000;

struct Unit {
	id: u16,
	x: f32,
	y: f32,
	z: f32,
	health: u8,
	moving: bool,
	crouched: bool
}

event Snapshot {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Compression: Repeat,
	Data: Unit
}

event Input {
	From: Client,
	Type: Unreliable,
	Call: SingleSync,
	Data: struct { move: u8, turn: i16, jump: bool, sprint: bool }
}

event Touch {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: (instance, u8)
}

event WorldState {
	From: Server,
	Type: Unreliable,
	Call: SingleSync,
	Data: array<Unit, 16>
}

event SelfState {
	From: Server,
	Type: Unreliable,
	Call: SingleSync,
	Data: Unit
}
